{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true
    },
    "include": [
        "apps/web/src/**/*.ts",
        "apps/web/src/**/*.vue",
        "packages/**/*.ts"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "**/.turbo",
        "**/.system_generated",
        "**/.gemini"
    ]
}
